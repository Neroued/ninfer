# Copy to .env, then `chmod 600 .env`. .env is gitignored and never enters the
# image: ninfer-serve reads NINFER_API_KEY directly, so the value stays out of
# `ps` and /proc/<pid>/cmdline. It is still visible to anyone who can reach the
# Docker daemon, via `docker inspect` or `docker compose config`.
#
# Migrating from serve-production.sh: its LLAMA_API_KEY fallback is gone. If
# that is the variable your shell exports, copy its value here.
NINFER_API_KEY=

# Optional: CUDA base-image tag used at build time. Lower it for an older
# driver, e.g. 13.2.1.
#NINFER_CUDA_VERSION=13.3.1

# Build
build/
build-*/
cmake-build-*/
*.o
*.obj
*.so
*.a
compile_commands.json
CMakeUserPresets.json
.cache/

# CUDA / profiling artifacts
*.nsys-rep
*.ncu-rep
*.qdrep
*.sqlite

# Python tooling
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# Weight artifacts (large; produced by offline tooling)
*.qus
*.bin
*.safetensors
*.gguf
*.ninfer
*.ninfer.conversion.json
/models/
out/

# Local workspace and transient runtime output
/.local/
/temp/
/temp-*/
/tmp/
/tmp-*/
/AGENTS.override.md
/logs/
/debug/
*.log
*.tmp
/core
/core.*

# Windows serve harness runtime assets (large / third-party; supply locally).
# scripts/windows/win_paths.ps1 resolves these via NINFER_FFMPEG_BIN /
# NINFER_CURL_BIN or a sibling third_party/ dir - they are NOT vendored here.
/third_party/

# Measurement raw corpora & intermediates (large; produced by offline tooling).
# The small final frequency stats under fixtures/ranking/ ARE tracked; the rest is ignored.
tools/freq_corpus/fixtures/*
!tools/freq_corpus/fixtures/ranking/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
profiles/
.chatgpt/

# Claude Code personal/local settings (may contain API tokens)
.claude/settings.local.json

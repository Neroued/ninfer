{
  "name": "ninfer-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run check && tsc -p tsconfig.server.json && vite build",
    "check": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/main.ts",
    "format": "prettier --write server shared web *.json *.ts index.html README.md"
  },
  "dependencies": {
    "@fastify/static": "^9.0.0",
    "better-sqlite3": "^13.0.3",
    "eventsource-parser": "^4.1.3",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "uplot": "^1.6.32",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  }
}

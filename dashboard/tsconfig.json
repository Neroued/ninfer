{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["web/**/*.ts", "web/**/*.vue", "shared/**/*.ts", "vite.config.ts"]
}
